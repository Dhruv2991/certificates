# Sender Email verified on your Brevo account
BREVO_SENDER_EMAIL=dhruvg.cs24@bmsce.ac.in
BREVO_SENDER_NAME=TeamCodeLocked

# Administrator Password for Dashboard (/admin)
# Administration is strictly restricted to dhruvg.cs24@bmsce.ac.in
ADMIN_PASSWORD=codelocked2026

# ==========================================
# Supabase PostgreSQL Database Configuration
# Obtain credentials from your Supabase project settings -> API
# ==========================================
